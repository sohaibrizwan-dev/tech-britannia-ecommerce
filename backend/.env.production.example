# =============================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Tech Britannia Backend
# =============================================================
# IMPORTANT: Copy this file to .env and update ALL values before deploying!
# Never commit your actual .env file to version control.
# =============================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database
# Use your production MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tech_britannia?retryWrites=true&w=majority

# JWT Configuration
# CRITICAL: Generate strong, unique secrets for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_MIN_64_CHARS_GENERATE_NEW_ONE
JWT_REFRESH_SECRET=YOUR_SUPER_SECRET_REFRESH_KEY_MIN_64_CHARS_DIFFERENT_FROM_JWT
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CORS Configuration
# Set to your production frontend URL (no trailing slash)
CORS_ORIGIN=https://your-production-domain.com

# Rate Limiting (stricter for production)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Credentials (for initial seeding only)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!

# Stripe Payment Processing
# Use your PRODUCTION Stripe keys (sk_live_* and whsec_*)
STRIPE_SECRET_KEY=sk_live_your_production_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Resend Email Configuration
# After verifying your domain at https://resend.com/domains
RESEND_API_KEY=re_your_production_resend_api_key
STORE_OWNER_EMAIL=support@your-domain.com
